import { useCallback, useState, useEffect, useRef } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import ReactFlow, {
  MiniMap,
  Controls,
  Background,
  useNodesState,
  useEdgesState,
  addEdge,
  MarkerType,
} from 'reactflow'
import 'reactflow/dist/style.css'
import {
  Zap, Activity, Send, Play, RefreshCw, MessageSquare,
  Terminal, CheckCircle, AlertCircle, Loader, X, Clock,
} from 'lucide-react'
import AgentNode from '../components/AgentNode'
import { agentAPI, metricsAPI } from '../services/api'
import axios from 'axios'

const API = '/api/v1'

const nodeTypes = {
  agentNode: AgentNode,
}

// Maps flow node IDs to backend agent IDs
const NODE_TO_AGENT = {
  health: 'health_agent',
  backup: 'backup_agent',
  recovery: 'recovery_agent',
  sql_tuning: 'sql_tuning_agent',
  capacity: 'capacity_agent',
  security: 'security_agent',
  browser: 'browser_agent',
}

// Maps node IDs to the tool-layer nodes they connect to
const NODE_TO_TOOLS = {
  health: 'hana_tools',
  backup: 'hana_tools',
  recovery: 'remote_exec',
  sql_tuning: 'hana_tools',
  capacity: 'hana_tools',
  security: 'remote_exec',
  browser: 'rag_tools',
}

// Quick actions per agent
const QUICK_ACTIONS = {
  supervisor: [
    { label: 'Check all agents', prompt: 'Give me a status summary of all agents and system health' },
    { label: 'Run full diagnostics', prompt: 'Run a full diagnostic check on the HANA system' },
  ],
  health: [
    { label: 'Health check', prompt: 'Run a health check on the HANA system' },
    { label: 'Check services', prompt: 'Check all HANA service statuses' },
    { label: 'Memory analysis', prompt: 'Analyze current memory usage on the HANA system' },
  ],
  backup: [
    { label: 'Backup status', prompt: 'Show the current backup status and last successful backup' },
    { label: 'List backups', prompt: 'List all recent HANA backups with their status' },
  ],
  recovery: [
    { label: 'Recovery readiness', prompt: 'Check disaster recovery readiness and latest recovery points' },
    { label: 'List snapshots', prompt: 'Show all available snapshots for recovery' },
  ],
  sql_tuning: [
    { label: 'Top queries', prompt: 'Show the top expensive SQL queries currently running' },
    { label: 'Index suggestions', prompt: 'Suggest index optimizations for the system' },
  ],
  capacity: [
    { label: 'Disk usage', prompt: 'Show current disk usage and capacity forecast' },
    { label: 'Growth trend', prompt: 'Analyze data growth trend for the last 30 days' },
  ],
  security: [
    { label: 'Security audit', prompt: 'Run a security audit on users and privileges' },
    { label: 'Check access', prompt: 'Check for overprivileged users or suspicious access patterns' },
  ],
  browser: [
    { label: 'Search SAP notes', prompt: 'Search SAP notes for recent HANA patches and fixes' },
    { label: 'Find docs', prompt: 'Find SAP documentation for HANA backup and recovery best practices' },
  ],
}

// Define the agent architecture
const initialNodes = [
  {
    id: 'supervisor',
    type: 'agentNode',
    position: { x: 400, y: 50 },
    data: { 
      label: 'Supervisor Agent',
      description: 'Orchestrates all agents & enforces policy',
      status: 'active',
      color: '#8b5cf6',
      isInteractive: true,
    },
  },
  {
    id: 'health',
    type: 'agentNode',
    position: { x: 100, y: 250 },
    data: { 
      label: 'Health Agent',
      description: 'Monitors system health metrics',
      status: 'active',
      color: '#10b981',
      isInteractive: true,
    },
  },
  {
    id: 'backup',
    type: 'agentNode',
    position: { x: 300, y: 250 },
    data: { 
      label: 'Backup Agent',
      description: 'Manages backup operations',
      status: 'active',
      color: '#3b82f6',
      isInteractive: true,
    },
  },
  {
    id: 'recovery',
    type: 'agentNode',
    position: { x: 500, y: 250 },
    data: { 
      label: 'Recovery Agent',
      description: 'Handles disaster recovery',
      status: 'active',
      color: '#f59e0b',
      isInteractive: true,
    },
  },
  {
    id: 'sql_tuning',
    type: 'agentNode',
    position: { x: 700, y: 250 },
    data: { 
      label: 'SQL Tuning Agent',
      description: 'Optimizes query performance',
      status: 'active',
      color: '#06b6d4',
      isInteractive: true,
    },
  },
  {
    id: 'capacity',
    type: 'agentNode',
    position: { x: 200, y: 450 },
    data: { 
      label: 'Capacity Agent',
      description: 'Manages resource capacity',
      status: 'active',
      color: '#ec4899',
      isInteractive: true,
    },
  },
  {
    id: 'security',
    type: 'agentNode',
    position: { x: 400, y: 450 },
    data: { 
      label: 'Security Agent',
      description: 'Monitors security threats',
      status: 'active',
      color: '#ef4444',
      isInteractive: true,
    },
  },
  {
    id: 'browser',
    type: 'agentNode',
    position: { x: 600, y: 450 },
    data: { 
      label: 'Browser Agent',
      description: 'Searches SAP documentation',
      status: 'active',
      color: '#14b8a6',
      isInteractive: true,
    },
  },
  // Tool nodes
  {
    id: 'hana_tools',
    type: 'agentNode',
    position: { x: 100, y: 650 },
    data: { 
      label: 'HANA Tools',
      description: 'Direct HANA connection',
      status: 'idle',
      color: '#6366f1',
    },
  },
  {
    id: 'remote_exec',
    type: 'agentNode',
    position: { x: 350, y: 650 },
    data: { 
      label: 'Remote Exec',
      description: 'OS-level operations via HTTP',
      status: 'idle',
      color: '#6366f1',
    },
  },
  {
    id: 'rag_tools',
    type: 'agentNode',
    position: { x: 600, y: 650 },
    data: { 
      label: 'RAG Tools',
      description: 'Knowledge base queries',
      status: 'idle',
      color: '#6366f1',
    },
  },
]

const initialEdges = [
  // Supervisor connections
  { id: 'e-sup-health', source: 'supervisor', target: 'health', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-backup', source: 'supervisor', target: 'backup', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-recovery', source: 'supervisor', target: 'recovery', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-sql', source: 'supervisor', target: 'sql_tuning', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-capacity', source: 'supervisor', target: 'capacity', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-security', source: 'supervisor', target: 'security', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sup-browser', source: 'supervisor', target: 'browser', type: 'smoothstep', animated: false, markerEnd: { type: MarkerType.ArrowClosed } },
  
  // Tool connections
  { id: 'e-health-hana', source: 'health', target: 'hana_tools', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-backup-hana', source: 'backup', target: 'hana_tools', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-recovery-exec', source: 'recovery', target: 'remote_exec', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-sql-hana', source: 'sql_tuning', target: 'hana_tools', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-capacity-hana', source: 'capacity', target: 'hana_tools', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-security-exec', source: 'security', target: 'remote_exec', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
  { id: 'e-browser-rag', source: 'browser', target: 'rag_tools', type: 'smoothstep', animated: false, style: { stroke: '#555' }, markerEnd: { type: MarkerType.ArrowClosed } },
]

// Find edges connected to a node (as source or target)
function getConnectedEdgeIds(nodeId, edgeList) {
  return edgeList.filter(e => e.source === nodeId || e.target === nodeId).map(e => e.id)
}

// Get the full path of edges for an agent: supervisor → agent → tool
function getFlowPath(nodeId) {
  const edges = []
  // supervisor → agent edge
  const supEdge = initialEdges.find(e => e.source === 'supervisor' && e.target === nodeId)
  if (supEdge) edges.push(supEdge.id)
  // agent → tool edge
  const toolTarget = NODE_TO_TOOLS[nodeId]
  if (toolTarget) {
    const toolEdge = initialEdges.find(e => e.source === nodeId && e.target === toolTarget)
    if (toolEdge) edges.push(toolEdge.id)
  }
  return edges
}

export default function AgentFlow() {
  const [nodes, setNodes, onNodesChange] = useNodesState(initialNodes)
  const [edges, setEdges, onEdgesChange] = useEdgesState(initialEdges)
  const [selectedNode, setSelectedNode] = useState(null)
  const [activeEdges, setActiveEdges] = useState([])
  const [highlightedEdges, setHighlightedEdges] = useState([])
  const [processingAgent, setProcessingAgent] = useState(null)
  const [messageInput, setMessageInput] = useState('')
  const [agentResponse, setAgentResponse] = useState(null)
  const [isProcessing, setIsProcessing] = useState(false)
  const [activityLog, setActivityLog] = useState([])
  const [liveAgentCount, setLiveAgentCount] = useState(0)
  const responseRef = useRef(null)

  // Poll backend for agent statuses
  useEffect(() => {
    let cancelled = false
    const poll = async () => {
      try {
        const res = await axios.get(`${API}/agents`)
        if (cancelled) return
        const agentList = res.data.agents || []
        setLiveAgentCount(agentList.filter(a => a.status === 'available').length)

        // Map backend statuses to node statuses
        const statusMap = {}
        agentList.forEach(a => { statusMap[a.id] = a.status })

        setNodes(nds => nds.map(n => {
          const backendId = NODE_TO_AGENT[n.id]
          if (!backendId) return n
          const backendStatus = statusMap[backendId]
          const newStatus = backendStatus === 'available' ? 'active'
            : backendStatus === 'unavailable' ? 'error' : n.data.status
          if (newStatus === n.data.status) return n
          return { ...n, data: { ...n.data, status: newStatus } }
        }))
      } catch { /* backend offline - keep current state */ }
    }
    poll()
    const id = setInterval(poll, 10000)
    return () => { cancelled = true; clearInterval(id) }
  }, [setNodes])

  // Poll recent activities
  useEffect(() => {
    let cancelled = false
    const poll = async () => {
      try {
        const res = await metricsAPI.getActivities(8)
        if (cancelled) return
        setActivityLog((res.data.activities || res.data || []).slice(0, 8))
      } catch { /* ignore */ }
    }
    poll()
    const id = setInterval(poll, 15000)
    return () => { cancelled = true; clearInterval(id) }
  }, [])

  const onConnect = useCallback(
    (params) => setEdges((eds) => addEdge(params, eds)),
    [setEdges],
  )

  // On node click: select + highlight connected edges
  const onNodeClick = useCallback((event, node) => {
    setSelectedNode(node)
    setAgentResponse(null)
    setMessageInput('')
    const connected = getConnectedEdgeIds(node.id, initialEdges)
    setHighlightedEdges(connected)
  }, [])

  // Click on background to deselect
  const onPaneClick = useCallback(() => {
    setSelectedNode(null)
    setHighlightedEdges([])
  }, [])

  // Send a message to the chat API, targeting a specific agent
  const sendAgentMessage = useCallback(async (prompt, targetNodeId) => {
    if (isProcessing) return
    setIsProcessing(true)
    setProcessingAgent(targetNodeId)
    setAgentResponse(null)

    // Animate the flow path edges 
    const flowEdges = targetNodeId === 'supervisor'
      ? initialEdges.filter(e => e.source === 'supervisor').map(e => e.id)
      : getFlowPath(targetNodeId)
    setActiveEdges(flowEdges)

    // Set the agent node to "processing" status
    setNodes(nds => nds.map(n => {
      if (n.id === targetNodeId) return { ...n, data: { ...n.data, status: 'processing' } }
      if (n.id === 'supervisor') return { ...n, data: { ...n.data, status: 'processing' } }
      return n
    }))

    try {
      const res = await agentAPI.chat(prompt)
      const answer = res.data?.response || res.data?.message || JSON.stringify(res.data)
      setAgentResponse({ type: 'success', text: answer })

      // Add to local activity log
      setActivityLog(prev => [{
        id: Date.now(),
        timestamp: new Date().toISOString(),
        action: `${selectedNode?.data?.label || targetNodeId}: "${prompt.slice(0, 60)}${prompt.length > 60 ? '...' : ''}"`,
        status: 'success',
      }, ...prev].slice(0, 8))
    } catch (err) {
      setAgentResponse({
        type: 'error',
        text: err.response?.data?.detail || err.message || 'Request failed',
      })
    } finally {
      setIsProcessing(false)
      setProcessingAgent(null)
      setActiveEdges([])
      // Restore node statuses
      setNodes(nds => nds.map(n => {
        if (n.id === targetNodeId || n.id === 'supervisor') {
          return { ...n, data: { ...n.data, status: 'active' } }
        }
        return n
      }))
    }
  }, [isProcessing, setNodes, selectedNode])

  const handleSend = () => {
    if (!messageInput.trim() || !selectedNode) return
    sendAgentMessage(messageInput.trim(), selectedNode.id)
    setMessageInput('')
  }

  // Compute edge styles: activeEdges (animated glow) > highlightedEdges (bright) > default (dim)
  const styledEdges = edges.map(edge => {
    const isActive = activeEdges.includes(edge.id)
    const isHighlighted = highlightedEdges.includes(edge.id)
    const nodeColor = selectedNode ? selectedNode.data.color : '#3b82f6'
    return {
      ...edge,
      animated: isActive,
      style: {
        ...edge.style,
        stroke: isActive ? nodeColor : isHighlighted ? nodeColor : edge.style?.stroke || '#555',
        strokeWidth: isActive ? 3 : isHighlighted ? 2 : 1,
        opacity: (highlightedEdges.length > 0 && !isHighlighted && !isActive) ? 0.25 : 1,
        transition: 'stroke 0.3s, stroke-width 0.3s, opacity 0.3s',
      },
    }
  })

  return (
    <div className="h-screen flex">
      {/* Flow Canvas */}
      <div className="flex-1 bg-gradient-to-br from-gray-900 via-blue-900/10 to-purple-900/10">
        <motion.div 
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          className="h-16 bg-gray-800/90 backdrop-blur border-b border-gray-700 flex items-center px-6"
        >
          <motion.div
            animate={{ 
              scale: [1, 1.1, 1],
              rotate: [0, 180, 360]
            }}
            transition={{ duration: 3, repeat: Infinity }}
          >
            <Zap className="w-6 h-6 text-yellow-400 mr-3" />
          </motion.div>
          <div>
            <h2 className="text-xl font-semibold bg-gradient-to-r from-blue-400 to-purple-500 bg-clip-text text-transparent">
              Agent Flow Architecture
            </h2>
            <p className="text-xs text-gray-400">Click an agent to interact &bull; Send commands &bull; Watch the flow</p>
          </div>
          <div className="ml-auto flex items-center space-x-6">
            {isProcessing && (
              <motion.div
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                className="flex items-center space-x-2 bg-blue-500/20 border border-blue-500/30 px-3 py-1 rounded-full"
              >
                <Loader className="w-3 h-3 text-blue-400 animate-spin" />
                <span className="text-xs text-blue-300">Processing...</span>
              </motion.div>
            )}
            <div className="flex items-center space-x-2">
              <Activity className="w-4 h-4 text-green-400" />
              <span className="text-sm text-gray-300">{liveAgentCount || nodes.filter(n => n.data.status === 'active').length} Agents</span>
            </div>
            <div className="flex items-center space-x-2">
              <motion.span 
                className="w-3 h-3 bg-green-500 rounded-full"
                animate={{ scale: [1, 1.3, 1] }}
                transition={{ repeat: Infinity, duration: 1.5 }}
              />
              <span className="text-sm text-gray-300">Live</span>
            </div>
          </div>
        </motion.div>
        
        <div className="h-[calc(100vh-4rem)]">
          <ReactFlow
            nodes={nodes}
            edges={styledEdges}
            onNodesChange={onNodesChange}
            onEdgesChange={onEdgesChange}
            onConnect={onConnect}
            onNodeClick={onNodeClick}
            onPaneClick={onPaneClick}
            nodeTypes={nodeTypes}
            fitView
          >
            <Controls />
            <MiniMap 
              nodeColor={(node) => node.data.color || '#666'}
              maskColor="rgba(0, 0, 0, 0.6)"
            />
            <Background variant="dots" gap={12} size={1} color="#3b82f6" />
          </ReactFlow>
        </div>
      </div>

      {/* Details Panel */}
      <AnimatePresence>
        {selectedNode && (
          <motion.div
            key={selectedNode.id}
            initial={{ x: 400, opacity: 0 }}
            animate={{ x: 0, opacity: 1 }}
            exit={{ x: 400, opacity: 0 }}
            transition={{ type: "spring", damping: 25 }}
            className="w-[420px] bg-gray-800 border-l border-gray-700 flex flex-col h-screen"
          >
            {/* Header */}
            <div className="p-5 border-b border-gray-700 flex-shrink-0">
              <div className="flex items-start justify-between">
                <div className="flex items-center gap-3">
                  <div className="w-3 h-3 rounded-full" style={{ backgroundColor: selectedNode.data.color }} />
                  <div>
                    <motion.h3 
                      initial={{ y: -10, opacity: 0 }}
                      animate={{ y: 0, opacity: 1 }}
                      className="text-lg font-semibold text-white"
                    >
                      {selectedNode.data.label}
                    </motion.h3>
                    <p className="text-xs text-gray-400 mt-0.5">{selectedNode.data.description}</p>
                  </div>
                </div>
                <motion.button 
                  whileHover={{ scale: 1.1, rotate: 90 }}
                  whileTap={{ scale: 0.9 }}
                  onClick={() => { setSelectedNode(null); setHighlightedEdges([]) }}
                  className="text-gray-400 hover:text-white p-1"
                >
                  <X className="w-4 h-4" />
                </motion.button>
              </div>
              <div className="flex items-center gap-4 mt-3">
                <div className="flex items-center gap-1.5">
                  <motion.span 
                    animate={selectedNode.data.status === 'processing' ? { scale: [1, 1.4, 1] } : { scale: [1, 1.2, 1] }}
                    transition={{ repeat: Infinity, duration: selectedNode.data.status === 'processing' ? 0.6 : 2 }}
                    className={`w-2 h-2 rounded-full ${
                      selectedNode.data.status === 'active' ? 'bg-green-500' : 
                      selectedNode.data.status === 'processing' ? 'bg-blue-500' :
                      selectedNode.data.status === 'error' ? 'bg-red-500' : 
                      'bg-gray-500'
                    }`}
                  />
                  <span className="text-xs text-gray-300 capitalize">{selectedNode.data.status}</span>
                </div>
                <span className="text-xs text-gray-500 font-mono">{selectedNode.id}</span>
              </div>
            </div>

            {/* Scrollable content */}
            <div className="flex-1 overflow-y-auto p-5 space-y-5">
              {/* Quick Actions */}
              {QUICK_ACTIONS[selectedNode.id] && (
                <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}>
                  <label className="text-xs text-gray-500 uppercase font-medium flex items-center gap-1.5">
                    <Play className="w-3 h-3" /> Quick Actions
                  </label>
                  <div className="mt-2 grid grid-cols-1 gap-1.5">
                    {QUICK_ACTIONS[selectedNode.id].map((action, idx) => (
                      <motion.button
                        key={idx}
                        initial={{ x: -20, opacity: 0 }}
                        animate={{ x: 0, opacity: 1 }}
                        transition={{ delay: 0.15 + idx * 0.05 }}
                        whileHover={{ x: 4, backgroundColor: 'rgba(139, 92, 246, 0.15)' }}
                        whileTap={{ scale: 0.98 }}
                        disabled={isProcessing}
                        onClick={() => sendAgentMessage(action.prompt, selectedNode.id)}
                        className="flex items-center gap-2 text-sm text-gray-300 p-2.5 rounded-lg bg-gray-700/30 border border-gray-700 hover:border-gray-600 text-left disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                      >
                        <Play className="w-3 h-3 text-purple-400 flex-shrink-0" />
                        {action.label}
                        {isProcessing && processingAgent === selectedNode.id && (
                          <Loader className="w-3 h-3 text-blue-400 animate-spin ml-auto" />
                        )}
                      </motion.button>
                    ))}
                  </div>
                </motion.div>
              )}

              {/* Agent Response */}
              <AnimatePresence>
                {agentResponse && (
                  <motion.div
                    ref={responseRef}
                    initial={{ opacity: 0, y: 20, height: 0 }}
                    animate={{ opacity: 1, y: 0, height: 'auto' }}
                    exit={{ opacity: 0, y: -10, height: 0 }}
                  >
                    <label className="text-xs text-gray-500 uppercase font-medium flex items-center gap-1.5">
                      <MessageSquare className="w-3 h-3" /> Response
                    </label>
                    <div className={`mt-2 p-3 rounded-lg text-sm max-h-64 overflow-y-auto ${
                      agentResponse.type === 'success'
                        ? 'bg-gray-700/40 border border-gray-600 text-gray-200'
                        : 'bg-red-900/20 border border-red-800/40 text-red-300'
                    }`}>
                      {agentResponse.type === 'success' ? (
                        <pre className="whitespace-pre-wrap font-sans">{agentResponse.text}</pre>
                      ) : (
                        <div className="flex items-start gap-2">
                          <AlertCircle className="w-4 h-4 text-red-400 mt-0.5 flex-shrink-0" />
                          <span>{agentResponse.text}</span>
                        </div>
                      )}
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>

              {/* Processing indicator */}
              <AnimatePresence>
                {isProcessing && processingAgent === selectedNode?.id && (
                  <motion.div
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    exit={{ opacity: 0 }}
                    className="flex items-center gap-3 p-3 bg-blue-500/10 border border-blue-500/20 rounded-lg"
                  >
                    <motion.div
                      animate={{ rotate: 360 }}
                      transition={{ repeat: Infinity, duration: 1, ease: 'linear' }}
                    >
                      <Loader className="w-4 h-4 text-blue-400" />
                    </motion.div>
                    <div>
                      <div className="text-sm text-blue-300">Agent processing...</div>
                      <div className="text-xs text-blue-400/60">Supervisor → {selectedNode.data.label} → Tools</div>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>

              {/* Capabilities */}
              <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}>
                <label className="text-xs text-gray-500 uppercase font-medium flex items-center gap-1.5">
                  <Terminal className="w-3 h-3" /> Capabilities
                </label>
                <div className="mt-2 space-y-1">
                  {getCapabilities(selectedNode.id).map((cap, idx) => (
                    <motion.div 
                      key={idx}
                      initial={{ x: -20, opacity: 0 }}
                      animate={{ x: 0, opacity: 1 }}
                      transition={{ delay: 0.25 + idx * 0.04 }}
                      className="text-xs text-gray-400 flex items-center gap-2 p-1.5"
                    >
                      <CheckCircle className="w-3 h-3 text-green-500/60 flex-shrink-0" />
                      {cap}
                    </motion.div>
                  ))}
                </div>
              </motion.div>

              {/* Activity Log */}
              <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}>
                <label className="text-xs text-gray-500 uppercase font-medium flex items-center gap-1.5">
                  <Clock className="w-3 h-3" /> Recent Activity
                </label>
                <div className="mt-2 space-y-1">
                  {activityLog.length > 0 ? activityLog.map((item, idx) => (
                    <ActivityItem
                      key={item.id || idx}
                      time={item.timestamp ? new Date(item.timestamp).toLocaleTimeString() : ''}
                      action={item.action || item.message || item.description || JSON.stringify(item)}
                      status={item.status}
                    />
                  )) : (
                    <div className="text-xs text-gray-500 p-2">No recent activity. Use quick actions or send a message to get started.</div>
                  )}
                </div>
              </motion.div>
            </div>

            {/* Chat input at bottom */}
            {selectedNode.data.isInteractive && (
              <div className="p-4 border-t border-gray-700 flex-shrink-0">
                <div className="flex gap-2">
                  <input
                    type="text"
                    value={messageInput}
                    onChange={e => setMessageInput(e.target.value)}
                    onKeyDown={e => e.key === 'Enter' && handleSend()}
                    disabled={isProcessing}
                    placeholder={`Ask ${selectedNode.data.label}...`}
                    className="flex-1 bg-gray-700/50 border border-gray-600 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-purple-500 disabled:opacity-40"
                  />
                  <motion.button
                    whileHover={{ scale: 1.05 }}
                    whileTap={{ scale: 0.95 }}
                    disabled={isProcessing || !messageInput.trim()}
                    onClick={handleSend}
                    className="px-3 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg text-white disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                  >
                    {isProcessing ? <Loader className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
                  </motion.button>
                </div>
              </div>
            )}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  )
}

function getCapabilities(nodeId) {
  const capabilities = {
    supervisor: [
      'Policy enforcement',
      'Agent orchestration',
      'Risk budget management',
      'Action approval workflow'
    ],
    health: [
      'System health monitoring',
      'Service status checks',
      'Alert detection',
      'Performance metrics'
    ],
    backup: [
      'Backup scheduling',
      'Backup verification',
      'Recovery point tracking',
      'Storage management'
    ],
    recovery: [
      'Disaster recovery planning',
      'System restoration',
      'Failover management',
      'Data recovery'
    ],
    sql_tuning: [
      'Query performance analysis',
      'Index recommendations',
      'Execution plan optimization',
      'Statistics updates'
    ],
    capacity: [
      'Resource utilization tracking',
      'Capacity forecasting',
      'Growth trend analysis',
      'Scaling recommendations'
    ],
    security: [
      'Security audit',
      'Access control monitoring',
      'Threat detection',
      'Compliance checks'
    ],
    browser: [
      'SAP note search',
      'Documentation lookup',
      'KB article retrieval',
      'Solution recommendations'
    ],
    hana_tools: [
      'SQL query execution',
      'System view access',
      'Configuration management',
      'Direct HANA connection'
    ],
    remote_exec: [
      'OS command execution',
      'File system access',
      'Process management',
      'System configuration'
    ],
    rag_tools: [
      'Vector search',
      'Semantic retrieval',
      'Knowledge base queries',
      'Context-aware responses'
    ]
  }
  return capabilities[nodeId] || []
}

function ActivityItem({ time, action, status }) {
  return (
    <motion.div 
      initial={{ opacity: 0, y: 5 }}
      animate={{ opacity: 1, y: 0 }}
      whileHover={{ x: 3, backgroundColor: 'rgba(139, 92, 246, 0.08)' }}
      className="text-xs p-2 rounded flex items-start gap-2"
    >
      {status === 'success' ? (
        <CheckCircle className="w-3 h-3 text-green-500 mt-0.5 flex-shrink-0" />
      ) : status === 'error' ? (
        <AlertCircle className="w-3 h-3 text-red-500 mt-0.5 flex-shrink-0" />
      ) : (
        <Activity className="w-3 h-3 text-gray-500 mt-0.5 flex-shrink-0" />
      )}
      <div className="flex-1 min-w-0">
        <div className="text-gray-300 truncate">{action}</div>
        {time && <div className="text-gray-500 text-[10px] mt-0.5">{time}</div>}
      </div>
    </motion.div>
  )
}
