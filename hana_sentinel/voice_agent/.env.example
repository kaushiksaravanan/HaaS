# HANA Sentinel Voice Agent - Environment Configuration
# =====================================================
# Copy this to .env and fill in the values.

# -- LiveKit Server --
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# -- HANA Sentinel API --
# URL of your running FastAPI server (main.py api)
SENTINEL_API_URL=http://localhost:8000

# Route speech through Sentinel API (true) or direct (false)
VOICE_USE_SENTINEL_PROXY=true

# -- Edge TTS Voice (optional) --
# See: https://github.com/ArisAgeworker/edge-tts#voices
EDGE_TTS_VOICE=en-US-AriaNeural
