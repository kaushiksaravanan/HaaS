# ──────────────────────────────────────────────
# HANA Sentinel — Environment Configuration
# ALL VALUES ARE CONFIGURABLE - NO HARDCODED DEFAULTS
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# SAP AI Core (GenAIHub) - Primary LLM Provider
# ──────────────────────────────────────────────
AICORE_BASE_URL=https://api.ai.intprod-eu12.eu-central-1.aws.ml.hana.ondemand.com/v2
AICORE_AUTH_URL=https://joule-internal-2pq4b1u1.authentication.eu12.hana.ondemand.com
AICORE_CLIENT_ID=sb-8407d6c3-e33a-43c4-a3d6-7b8259b4c8ad!b1292179|xsuaa_std!b318061
AICORE_CLIENT_SECRET=AICORE_SECRET_REVOKED_PLACEHOLDER_00000000000000000000
AICORE_RESOURCE_GROUP=default

# LLM Model Configuration (Used by Orchestrator and Agents)
# Options: gpt-4o, gpt-4o-mini, anthropic--claude-4.6-sonnet, anthropic--claude-3-5-sonnet
LLM_MODEL_NAME=gpt-4o
LLM_DEPLOYMENT_ID=d0a0e16c35c28ed2

# Google Cloud / Vertex AI (Fallback / GCP Services)
GOOGLE_CLOUD_PROJECT=sap-development
GOOGLE_CLOUD_LOCATION=europe-west3
GOOGLE_APPLICATION_CREDENTIALS=hana_db_agent_toolkit/sap-development-23f9847d3c33.json

# GCP Authentication (used by gcloud_auth.py)
GCP_AUTH_EMAIL=uihost@sap-development.iam.gserviceaccount.com

# SAP HANA Database (Docker container hxehana on GCE VM)
# Internal IP of the VM; HANA ports forwarded from container
# HANA_HOST=10.128.0.2
# Using External IP for local testing (if firewall allows)
HANA_HOST=35.238.233.131
HANA_PORT=39013
HANA_USER=SYSTEM
HANA_PASSWORD=HANA_PASSWORD_REVOKED_PLACEHOLDER_00000000000000000000
HANA_SID=HXE
HANA_INSTANCE_NR=00
HANA_ENCRYPT=false
HANA_SSL_VALIDATE=false
HANA_CONNECT_TIMEOUT=15
HANA_MAX_RETRIES=3

# SSH Access (via gcloud compute ssh ONLY - direct SSH blocked)
# For vlgdbzo3: Uses GCP_TOOLKIT_* variables and zo3adm user
# For legacy instance: Uses these variables
SSH_HOST=
SSH_USER=
SSH_PORT=22
SSH_KEY_PATH=
SSH_PASSWORD=

# GCP Instance for HANA DB Agent Toolkit
GCP_SERVICE_KEY_PATH=hana_db_agent_toolkit/sap-development-23f9847d3c33.json
GCP_TOOLKIT_PROJECT_ID=sap-development
GCP_TOOLKIT_INSTANCE_NAME=vlgdbzo3
GCP_TOOLKIT_ZONE=europe-west3-a
GCP_TOOLKIT_HANA_USER=zo3adm
GCP_TOOLKIT_HANA_SID=ZO3
GCP_TOOLKIT_INSTANCE_NUMBER=02

# HANA Cockpit (for Verifier Agent browser checks)
HANA_COCKPIT_URL=
SAP_SUPPORT_URL=https://me.sap.com/notes
BROWSER_ALLOWED_DOMAINS=support.sap.com,me.sap.com,launchpad.support.sap.com

# global.ini Compliance
GLOBAL_INI_PATH=/usr/sap/HXE/SYS/global/hdb/custom/config/global.ini
# Format: key1=val1,key2=val2
GLOBAL_INI_REQUIRED_ENTRIES=

# RAG Engine
RAG_LOCAL_KB_DIR=

# ──────────────────────────────────────────────
# DYNAMIC FORMULAS — Risk Budget & Governance
# ──────────────────────────────────────────────

# Risk Budget
RISK_DAILY_BASELINE=100

# Trust Multiplier Formula
TRUST_REWARD_DAYS=7
TRUST_REWARD_FACTOR=1.1
TRUST_MAX_MULTIPLIER=1.5
TRUST_PENALTY_MULTIPLIER=0.75

# Behavioral Gate Thresholds (% of budget consumed)
GATE_HOOTL_MAX=50
GATE_HOTL_MAX=75
GATE_HITL_ASYNC_MAX=90
GATE_HITL_SYNC_MAX=100

# Policy Engine
HIGH_RISK_THRESHOLD=12
FROZEN_ALLOWED_OPS=read_monitoring,log_analysis,config_read
UNKNOWN_OP_COST=25

# Health Thresholds
CPU_WARNING_PCT=80
CPU_CRITICAL_PCT=95
MEM_WARNING_PCT=85
MEM_CRITICAL_PCT=95
DISK_WARNING_PCT=80
DISK_CRITICAL_PCT=90
BACKUP_MAX_AGE_HOURS=24

# ──────────────────────────────────────────────
# Dynamic Risk Scores (Likelihood x Impact)
# Override individual operations or use JSON for bulk:
# ──────────────────────────────────────────────
# RISK_SCORES_JSON={"read_monitoring":1,"service_restart":12}
RISK_read_monitoring=1
RISK_log_analysis=2
RISK_config_read=1
RISK_parameter_change=6
RISK_global_ini_mod=6
RISK_backup_execution=6
RISK_service_restart=12
RISK_security_change=8
RISK_data_modification=15
RISK_failover_trigger=20

# ──────────────────────────────────────────────
# Docker Container Monitoring
# ──────────────────────────────────────────────
HANA_CONTAINER_NAME=hxehana
CONTAINER_USER=hxeadm
CONTAINER_RUNTIME=docker
DOCKER_SSH_HOST=
REMOTE_DOCKER_BIN=docker

# GCP Pub/Sub (event-driven monitoring)
PUBSUB_ALERT_TOPIC=hana-sentinel-alerts
PUBSUB_EVENT_SUBSCRIPTION=hana-sentinel-events-sub

# GCP Cloud Run (agent deployment)
CLOUDRUN_SERVICE=hana-sentinel-agent
CLOUDRUN_SERVICE_URL=
CLOUDRUN_ID_TOKEN=

# Learning Store (dynamic command persistence)
LEARNING_STORE_PATH=

# Log Preprocessor
LOG_MAX_CHARS=4000
LOG_MAX_LINES=80

# HDB Storage Paths (for monitoring agent)
HANA_DATA_PATH=/hana/data
HANA_LOG_PATH=/hana/log
HANA_BACKUP_PATH=/hana/backup
HANA_SHARED_PATH=/hana/shared

# ADK Model Configuration
ADK_MODEL=gpt-4o

# ──────────────────────────────────────────────
# HTTP Command Execution (Alternative to gcloud SSH)
# ──────────────────────────────────────────────
# Remote execution server running on vlgdbzo3 instance
# Pre-configured secure base64 API key (matches remote_exec_server.py)
REMOTE_EXEC_URL=http://10.238.36.146:9999
REMOTE_EXEC_API_KEY=REMOTE_EXEC_KEY_REVOKED_PLACEHOLDER_0000000000000000

# Boot disk name for snapshot management
GCP_BOOT_DISK=vlgdbzo3-20241104050801
